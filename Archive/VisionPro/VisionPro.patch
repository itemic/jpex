+        }
+        .windowStyle(.plain)
+        .windowResizability(.contentSize)
+        .defaultWindowPlacement { _, context in
+            // Beside the lists, on the other side from the globe.
+            guard let lists = context.windows.first(where: { $0.id == nil }) else { return WindowPlacement() }
+            return WindowPlacement(.leading(lists))
+        }
+        .defaultLaunchBehavior(.suppressed)
+        #endif
+    }
+}
+
+private extension View {
+    /// The person's saves and how they count places, the same in every window.
+    func sharingTravels(_ saveStore: SaveStore, counting: CountingPreferences) -> some View {
+        self
+            // Made anew on each store, so nothing holds a save from the last one.
+            .id(saveStore.generation)
+            .modelContainer(saveStore.container)
+            .environment(saveStore)
+            .environment(counting)
+            .environment(CustomWorldGroups.shared)
+            .appliesMotionPreference()
     }
 }
