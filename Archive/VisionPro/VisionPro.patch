-                .environment(saveStore)
-                .environment(countingPreferences)
-                .environment(CustomWorldGroups.shared)
-                .appliesMotionPreference()
+                .sharingTravels(saveStore, counting: countingPreferences)
         }
+        #if os(visionOS)
+        // The World as a globe in a volume, floating in the room beside the lists. It presents the
+        // World, so asking for it again brings the one already out to the front. A `Window` would
+        // too, but on Apple Vision Pro a second request while it's still opening crashes it.
+        WindowGroup(id: SpatialWindow.globe.rawValue, for: String.self) { _ in
+            GlobeVolume()
